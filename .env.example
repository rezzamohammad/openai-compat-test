# OpenAI Compatible API Tester Configuration

# API Settings (required)
OAI_TEST_BASE_URL=http://localhost:8000
OAI_TEST_API_KEY=sk-your-api-key

# Request Settings (optional)
OAI_TEST_MAX_TOKENS=30000
OAI_TEST_COMPLETIONS_PATH=/v1/chat/completions
OAI_TEST_TIMEOUT=50000
OAI_TEST_REQUEST_DELAY_MS=500
OAI_TEST_VERBOSE=1

# Proxy settings
PROXY_PORT=9318
OAI_TEST_DEFAULT_MODEL=cx/gpt-5.5-xhigh
